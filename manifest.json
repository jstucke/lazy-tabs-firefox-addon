{
  "manifest_version": 2,
  "name": "Lazy Background Tabs",
  "version": "1.1.0",
  "description": "Öffnet Links in Hintergrund-Tabs, die erst beim Anklicken geladen werden (Lesezeichen-Ordner, Kontextmenü, optional Mittelklick und Strg+Klick).",
  "icons": {
    "16": "icons/icon-16.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lazy-background-tabs@jstucke",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "menus",
    "cookies",
    "bookmarks",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
